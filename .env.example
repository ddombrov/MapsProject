# Copy this file to .env.local and fill in your own keys. .env.local is git-ignored,
# so your real keys are never committed. Restart the dev server after changing it.

# ---------------------------------------------------------------- Required

# Google Maps JavaScript API key. This one is sent to the browser by design, so restrict it
# to your site's domain (Google Cloud Console > Credentials > Application restrictions >
# HTTP referrers), and to the Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Google key, never sent to the browser. Enable these APIs on its project:
#   Places API (New), Geocoding API, Routes API
# If you restrict the key by API, allow exactly those three.
GOOGLE_PLACES_API_KEY=

# Itinerary generation uses Gemini first and falls back to OpenAI if it fails, so at least one
# of these is needed to build trips. OpenAI is also what powers the chat assistant.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- Optional

# Reddit adds real traveler and local opinions as a source. Free: create a "script" app at
# https://www.reddit.com/prefs/apps. The client ID is the string under the app name and the
# secret is labeled "secret". Leave blank and the Reddit slider stays disabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Ticketmaster adds events happening during your trip dates. Free: sign in at
# https://developer.ticketmaster.com/, open My Apps > New App, and copy the Consumer Key.
# Leave blank and the Ticketmaster slider stays disabled.
TICKETMASTER_API_KEY=

# Supabase backs a shared pool of real places per city (see docs/HANDOFF.md), so a popular
# city accumulates more candidates over time instead of every trip starting from a fresh
# Google search alone. Entirely optional and fails soft — leave blank and generation behaves
# exactly as it does without it. Project Settings > API Keys in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to the browser; it's only read server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
